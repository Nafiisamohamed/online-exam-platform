# Copy this file to .env.test (never commit .env.test).
#
# Dedicated database for the automated tests. Rules enforced by the test setup:
# - the database name MUST end with "_test"
# - it MUST NOT be the same database as DATABASE_URL in .env
# Every test run deletes and rebuilds everything in this database.
# If the database does not exist yet, the test run creates it (the user needs
# permission to create databases).
TEST_DATABASE_URL="postgresql://exam_user:change_me@localhost:5432/online_exam_test?schema=public"
