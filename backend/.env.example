# Copy this file to .env and fill in local values. Never commit .env.
# See docs/database-environments.md for the full setup.

# Express application: the restricted role exam_app (no owner rights).
DATABASE_URL="postgresql://exam_app:change_me@localhost:5432/online_exam?schema=public"

# Prisma migrations only: the database owner. Keep this off the application
# server; set it only on the machine that runs `npm run db:migrate`.
MIGRATE_DATABASE_URL="postgresql://exam_owner:change_me@localhost:5432/online_exam?schema=public"

# -----------------------------------------------------------------------------
# Hosted environment (Supabase): formats only. Supabase is NOT used for campus
# examinations. Use the Session Pooler (port 5432); <project-ref> is the
# project's ID and <region> its region, e.g. eu-central-1. URL-encode special
# characters in passwords (@ -> %40, # -> %23, : -> %3A, / -> %2F, % -> %25).
#
# The parameters after "?" make TLS fully verified: the server certificate is
# checked against Supabase's root CA in certs/supabase-ca-2021.crt (path
# relative to backend/). connect_timeout=30 allows for a slow handshake.
#
# Migrations (owner) - only on the machine that runs migrations:
# MIGRATE_DATABASE_URL="postgresql://postgres.<project-ref>:change_me@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require&sslcert=certs/supabase-ca-2021.crt&sslaccept=strict&connect_timeout=30"
#
# Application (exam_app) - written for you by `npm run db:app-password`:
# DATABASE_URL="postgresql://exam_app.<project-ref>:change_me@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require&sslcert=certs/supabase-ca-2021.crt&sslaccept=strict&connect_timeout=30"
#
# Never run `npm test`, `npm run db:migrate:dev` or `prisma migrate reset`
# against Supabase.
