# Copy this file to .env.supabase-test (never commit .env.supabase-test).
# Used only by:  npm run test:supabase
#
# Use a SEPARATE Supabase project that exists only for tests. Never the
# production project. Every run deletes and rebuilds the application's tables.
#
# Connect as the project owner (postgres) through the direct connection, or the
# session pooler (port 5432) if your network has no IPv6. Not the transaction
# pooler (port 6543). Supabase requires TLS.
TEST_DATABASE_URL="postgresql://postgres:change_me@db.TESTPROJECTREF.supabase.co:5432/postgres?sslmode=require"
TEST_SUPABASE_PROJECT_REF="testprojectref"

# One-time setup, in the TEST project's SQL editor only (never in production):
#   CREATE SCHEMA test_guard;
#   CREATE TABLE test_guard.marker (project_ref text PRIMARY KEY);
#   INSERT INTO test_guard.marker VALUES ('<the test project ref>');
