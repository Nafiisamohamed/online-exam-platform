# Copy this file to .env.supabase-test (never commit .env.supabase-test).
# Used only by:  npm run test:supabase
#
# Use a SEPARATE Supabase project that exists only for tests. Never the main
# project: every run deletes and rebuilds the application's tables. The main
# project is also blocked in tests/helpers/env.mjs.
#
# Connect as the test project's owner through the Session Pooler (port 5432),
# not the Transaction Pooler (port 6543). Copy the Session Pooler string from
# the dashboard's "Connect" button, then add ?sslmode=require.
# <test-project-ref> is the TEST project's ID; <region> e.g. eu-central-1.
TEST_DATABASE_URL="postgresql://postgres.<test-project-ref>:change_me@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require&sslcert=certs/supabase-ca-2021.crt&sslaccept=strict&connect_timeout=30"
TEST_SUPABASE_PROJECT_REF="<test-project-ref>"

# One-time setup, in the TEST project's SQL editor only (never in the main project):
#   CREATE SCHEMA test_guard;
#   CREATE TABLE test_guard.marker (project_ref text PRIMARY KEY);
#   INSERT INTO test_guard.marker VALUES ('<test-project-ref>');
