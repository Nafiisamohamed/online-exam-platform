// =============================================================================
// Online Exam Platform (Project 18) - database schema
// -----------------------------------------------------------------------------
// Design v2 (approved). 35 tables in 8 groups:
//   A. Users and access        D. Exams and scheduling   G. Payments and messages
//   B. Courses and enrolment   E. Attempts               (H. analytics = queries only)
//   C. Question bank           F. Grading and results
//
// Conventions
// - Table and column names are snake_case in PostgreSQL (@@map / @map).
// - Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid()).
// - All timestamps are timestamptz (stored in UTC).
// - Foreign keys use RESTRICT: history rows are never removed by cascade.
//
// Rules that Prisma cannot express (CHECK constraints, triggers, partial
// unique indexes) live as raw SQL at the end of the first migration and are
// documented in docs/database.md.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum RoleName {
  ADMIN
  LECTURER
  STUDENT
  INVIGILATOR
}

enum Language {
  so
  en
}

enum EnrolmentStatus {
  ACTIVE
  DROPPED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ImportType {
  QUESTIONS
  ENROLMENTS
}

enum ImportStatus {
  PREVIEW
  CONFIRMED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

enum ResultsStatus {
  UNPUBLISHED
  PUBLISHED
  REOPENED
}

enum ScheduleStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  /// Closed automatically at the third counted tab switch (saved answers kept).
  TERMINATED
}

enum SubmissionType {
  MANUAL
  AUTO_DEADLINE
  /// The attempt was terminated after the maximum number of counted tab switches.
  TERMINATED_TAB_LIMIT
}

/// Set at submission time. NULL while the attempt is still in progress.
enum GradingStatus {
  AUTO_CORRECT
  AUTO_INCORRECT
  NEEDS_REVIEW
  PENDING_ESSAY
  AWAITING_SECOND_GRADE
  DISCREPANCY
  GRADED
  NOT_ANSWERED
}

enum GraderRole {
  FIRST
  SECOND
}

enum PaymentProvider {
  EVC_PLUS
  ZAAD
  EDAHAB
}

enum PaymentStatus {
  PENDING_CONFIRMATION
  PENDING_PIN
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

// =============================================================================
// A. Users and access
// =============================================================================

/// The four official roles. Each user has exactly one role (Q2).
/// One counter per role and year for automatic account numbers. The next number is taken with
/// an atomic upsert (row lock), so two accounts created at the same moment never share a number.
model AccountNumberSequence {
  role      RoleName
  year      Int
  lastValue Int      @map("last_value")

  @@id([role, year])
  @@map("account_number_sequences")
}

model Role {
  id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  RoleName @unique
  users User[]

  @@map("roles")
}

/// Everyone who can log in, with their username (S-/T-/R-/I-YYYY-NNN, generated by the server)
/// or, for staff, their email. A student's student_number is their username.
model User {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId                String    @map("role_id") @db.Uuid
  /// S-2026-001 (student), T- (lecturer), R- (registrar), I- (invigilator): from account_number_sequences.
  username              String    @unique
  studentNumber         String?   @unique @map("student_number")
  /// The number the account had before automatic numbering (e.g. DEMO-2026-0007), kept for reference.
  legacyNumber          String?   @map("legacy_number")
  email                 String?   @unique
  fullName              String    @map("full_name")
  phone                 String
  passwordHash          String    @map("password_hash")
  /// D3/Q1: imported students get a temporary password and must change it.
  mustChangePassword    Boolean   @default(false) @map("must_change_password")
  tempPasswordExpiresAt DateTime? @map("temp_password_expires_at") @db.Timestamptz(6)
  preferredLanguage     Language  @default(so) @map("preferred_language")
  isActive              Boolean   @default(true) @map("is_active")
  /// Incremented to invalidate all existing login tokens for this user.
  tokenVersion          Int       @default(0) @map("token_version")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  auditLogs              AuditLog[]
  coursesTaught          Course[]              @relation("CourseLecturer")
  enrolments             Enrolment[]
  questionsCreated       Question[]            @relation("QuestionCreator")
  importBatches          ImportBatch[]
  examsCreated           Exam[]                @relation("ExamCreator")
  examsSecondGraded      Exam[]                @relation("ExamSecondGrader")
  schedulesRequested     ExamSchedule[]        @relation("ScheduleRequester")
  schedulesDecided       ExamSchedule[]        @relation("ScheduleDecider")
  invigilatorAssignments ScheduleInvigilator[]
  attempts               ExamAttempt[]
  answersGraded          Answer[]              @relation("AnswerGrader")
  extensionsGranted      TimeExtension[]
  notesWritten           InvigilatorNote[]     @relation("NoteAuthor")
  notesAbout             InvigilatorNote[]     @relation("NoteStudent")
  essayMarks             EssayMark[]
  publications           ResultPublication[]
  payments               Payment[]
  smsMessages            SmsOutbox[]
  notifications          Notification[]

  @@index([roleId])
  @@map("users")
}

/// Append-only log of sensitive actions (who, what, when). Baseline 6.2.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL for actions performed by the system itself (e.g. auto-submit).
  actorId    String?  @map("actor_id") @db.Uuid
  actionCode String   @map("action_code")
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// B. Courses and enrolment
// =============================================================================

model Faculty {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses Course[]

  @@map("faculties")
}

/// A course offering in one semester (Q3: unique by code + semester).
model Course {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId  String   @map("faculty_id") @db.Uuid
  code       String
  name       String
  semester   String
  lecturerId String   @map("lecturer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  faculty  Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  lecturer User    @relation("CourseLecturer", fields: [lecturerId], references: [id], onDelete: Restrict)

  enrolments    Enrolment[]
  topics        Topic[]
  questions     Question[]
  importBatches ImportBatch[]
  exams         Exam[]

  @@unique([code, semester])
  @@index([facultyId])
  @@index([lecturerId])
  @@map("courses")
}

/// Dropping a student sets status = DROPPED; the row (and their results) stay.
model Enrolment {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String          @map("student_id") @db.Uuid
  courseId   String          @map("course_id") @db.Uuid
  status     EnrolmentStatus @default(ACTIVE)
  enrolledAt DateTime        @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  droppedAt  DateTime?       @map("dropped_at") @db.Timestamptz(6)

  student User   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@map("enrolments")
}

// =============================================================================
// C. Question bank
// =============================================================================

model Topic {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  questionVersions QuestionVersion[]
  examRuleTopics   ExamRuleTopic[]

  @@unique([courseId, name])
  @@map("topics")
}

/// Stable identity of a question. Content lives in QuestionVersion.
model Question {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  createdById      String   @map("created_by") @db.Uuid
  currentVersionId String?  @unique @map("current_version_id") @db.Uuid
  /// D19: lowercased, trimmed, repeated spaces collapsed. Used for duplicate checks.
  normalizedText   String   @map("normalized_text")
  isArchived       Boolean  @default(false) @map("is_archived")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course         Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  currentVersion QuestionVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions       QuestionVersion[] @relation("QuestionVersions")

  @@index([courseId])
  @@map("questions")
}

/// Content of one question version. Locked (read-only) once any attempt uses it (P4).
model QuestionVersion {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId    String       @map("question_id") @db.Uuid
  versionNumber Int          @map("version_number")
  type          QuestionType
  text          String
  imagePath     String?      @map("image_path")
  marks         Decimal      @db.Decimal(6, 2)
  difficulty    Difficulty
  topicId       String       @map("topic_id") @db.Uuid
  isLocked      Boolean      @default(false) @map("is_locked")
  lockedAt      DateTime?    @map("locked_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  question  Question  @relation("QuestionVersions", fields: [questionId], references: [id], onDelete: Restrict)
  currentOf Question? @relation("CurrentVersion")
  topic     Topic     @relation(fields: [topicId], references: [id], onDelete: Restrict)

  options          QuestionOption[]
  acceptedAnswers  AcceptedAnswer[]
  rubricCriteria   RubricCriterion[]
  attemptQuestions AttemptQuestion[]

  @@unique([questionId, versionNumber])
  @@index([topicId])
  @@index([difficulty, type, marks])
  @@map("question_versions")
}

/// Choices for MCQ (4-5) and True/False (2). Exactly one is correct.
model QuestionOption {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionVersionId String  @map("question_version_id") @db.Uuid
  text              String
  isCorrect         Boolean @default(false) @map("is_correct")
  position          Int

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  answers         Answer[]

  @@unique([questionVersionId, position])
  /// Target of the composite foreign key from answers (P8).
  @@unique([questionVersionId, id])
  @@map("question_options")
}

/// Accepted answers for short-answer questions (D20 normalisation).
model AcceptedAnswer {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionVersionId String @map("question_version_id") @db.Uuid
  answerText        String @map("answer_text")
  normalizedText    String @map("normalized_text")

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)

  @@unique([questionVersionId, normalizedText])
  @@map("accepted_answers")
}

/// Rubric criteria for essay questions. Criteria marks add up to the question marks.
model RubricCriterion {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionVersionId String  @map("question_version_id") @db.Uuid
  description       String
  maxMarks          Decimal @map("max_marks") @db.Decimal(6, 2)
  position          Int

  questionVersion QuestionVersion      @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  criterionMarks  EssayCriterionMark[]

  @@unique([questionVersionId, position])
  @@map("rubric_criteria")
}

/// CSV import preview and history. row_results stores error codes, not sentences (P10).
model ImportBatch {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          ImportType
  courseId      String?      @map("course_id") @db.Uuid
  semester      String?
  uploadedById  String       @map("uploaded_by") @db.Uuid
  filename      String
  status        ImportStatus @default(PREVIEW)
  totalRows     Int          @default(0) @map("total_rows")
  validRows     Int          @default(0) @map("valid_rows")
  invalidRows   Int          @default(0) @map("invalid_rows")
  duplicateRows Int          @default(0) @map("duplicate_rows")
  rowResults    Json         @map("row_results")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  course     Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([uploadedById])
  @@map("import_batches")
}

// =============================================================================
// D. Exams and scheduling
// =============================================================================

model Exam {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId          String        @map("course_id") @db.Uuid
  createdById       String        @map("created_by") @db.Uuid
  title             String
  instructions      String
  shuffleQuestions  Boolean       @default(true) @map("shuffle_questions")
  shuffleOptions    Boolean       @default(true) @map("shuffle_options")
  allowAnswerReview Boolean       @default(false) @map("allow_answer_review")
  /// D1: 0 = free exam. Currency is configurable per exam (P9).
  feeAmount         Decimal       @default(0) @map("fee_amount") @db.Decimal(12, 2)
  feeCurrency       String        @map("fee_currency") @db.Char(3)
  status            ExamStatus    @default(DRAFT)
  resultsStatus     ResultsStatus @default(UNPUBLISHED) @map("results_status")
  /// D7: optional blind second grader for essays.
  secondGraderId    String?       @map("second_grader_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  course       Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy    User   @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  secondGrader User?  @relation("ExamSecondGrader", fields: [secondGraderId], references: [id], onDelete: Restrict)

  rules        ExamRule[]
  schedules    ExamSchedule[]
  attempts     ExamAttempt[]
  publications ResultPublication[]
  payments     Payment[]

  @@index([courseId])
  @@map("exams")
}

/// One selection rule: N questions of one type, difficulty and mark value (D5, P2).
model ExamRule {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId           String       @map("exam_id") @db.Uuid
  questionType     QuestionType @map("question_type")
  difficulty       Difficulty
  marksPerQuestion Decimal      @map("marks_per_question") @db.Decimal(6, 2)
  questionCount    Int          @map("question_count")
  position         Int

  exam             Exam              @relation(fields: [examId], references: [id], onDelete: Restrict)
  topics           ExamRuleTopic[]
  attemptQuestions AttemptQuestion[]

  @@unique([examId, position])
  /// P2: one rule per type + difficulty + marks combination within an exam.
  @@unique([examId, questionType, difficulty, marksPerQuestion])
  @@map("exam_rules")
}

/// Topics a rule draws from. No rows = any topic in the course.
model ExamRuleTopic {
  ruleId  String @map("rule_id") @db.Uuid
  topicId String @map("topic_id") @db.Uuid

  rule  ExamRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  topic Topic    @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([ruleId, topicId])
  @@map("exam_rule_topics")
}

/// Lecturer requests, admin approves. At most one APPROVED schedule per exam.
model ExamSchedule {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId          String         @map("exam_id") @db.Uuid
  requestedById   String         @map("requested_by") @db.Uuid
  decidedById     String?        @map("decided_by") @db.Uuid
  status          ScheduleStatus @default(REQUESTED)
  windowStart     DateTime       @map("window_start") @db.Timestamptz(6)
  windowEnd       DateTime       @map("window_end") @db.Timestamptz(6)
  durationMinutes Int            @map("duration_minutes")
  rejectionReason String?        @map("rejection_reason")
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  exam        Exam  @relation(fields: [examId], references: [id], onDelete: Restrict)
  requestedBy User  @relation("ScheduleRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("ScheduleDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  rooms        ScheduleRoom[]
  invigilators ScheduleInvigilator[]
  attempts     ExamAttempt[]
  notes        InvigilatorNote[]

  /// Target of the composite foreign key from exam_attempts.
  @@unique([examId, id])
  @@index([status, windowStart, windowEnd])
  @@map("exam_schedules")
}

/// Exam room with the campus network ranges (CIDR) allowed to start from it.
model Room {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @unique
  building      String
  networkRanges String[] @map("network_ranges")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  schedules ScheduleRoom[]

  @@map("rooms")
}

model ScheduleRoom {
  scheduleId String @map("schedule_id") @db.Uuid
  roomId     String @map("room_id") @db.Uuid

  schedule ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  room     Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@id([scheduleId, roomId])
  @@map("schedule_rooms")
}

model ScheduleInvigilator {
  scheduleId    String @map("schedule_id") @db.Uuid
  invigilatorId String @map("invigilator_id") @db.Uuid

  schedule    ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  invigilator User         @relation(fields: [invigilatorId], references: [id], onDelete: Restrict)

  @@id([scheduleId, invigilatorId])
  @@index([invigilatorId])
  @@map("schedule_invigilators")
}

// =============================================================================
// E. Attempts (core technical challenge)
// =============================================================================

/// One student sitting one exam (Q6: unique per exam + student).
/// deadline = base_deadline + total_extension_minutes (enforced by CHECK).
model ExamAttempt {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId                String          @map("exam_id") @db.Uuid
  scheduleId            String          @map("schedule_id") @db.Uuid
  studentId             String          @map("student_id") @db.Uuid
  status                AttemptStatus   @default(IN_PROGRESS)
  submissionType        SubmissionType? @map("submission_type")
  startedAt             DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  /// min(started_at + duration, window_end)
  baseDeadline          DateTime        @map("base_deadline") @db.Timestamptz(6)
  /// P5: 0-15 minutes in total (CHECK).
  totalExtensionMinutes Int             @default(0) @map("total_extension_minutes")
  deadline              DateTime        @db.Timestamptz(6)
  submittedAt           DateTime?       @map("submitted_at") @db.Timestamptz(6)
  lastSeenAt            DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  countedFocusLosses    Int             @default(0) @map("counted_focus_losses")
  startIp               String?         @map("start_ip")

  exam     Exam         @relation(fields: [examId], references: [id], onDelete: Restrict)
  /// Composite key guarantees the schedule belongs to the same exam.
  schedule ExamSchedule @relation(fields: [examId, scheduleId], references: [examId, id], onDelete: Restrict)
  student  User         @relation(fields: [studentId], references: [id], onDelete: Restrict)

  questions      AttemptQuestion[]
  answers        Answer[]
  focusEvents    FocusEvent[]
  extensions     TimeExtension[]
  grade          Grade?
  gradeRevisions GradeRevision[]

  @@unique([examId, studentId])
  /// Used by the auto-submit job (P6).
  @@index([status, deadline])
  @@index([scheduleId])
  @@index([studentId])
  @@map("exam_attempts")
}

/// The frozen exam a student received: version, order, option order, marks.
model AttemptQuestion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  questionVersionId String   @map("question_version_id") @db.Uuid
  examRuleId        String   @map("exam_rule_id") @db.Uuid
  position          Int
  /// Option IDs in the order this student sees them. Empty for short answer / essay.
  optionOrder       String[] @map("option_order") @db.Uuid
  marks             Decimal  @db.Decimal(6, 2)
  isFlagged         Boolean  @default(false) @map("is_flagged")

  attempt         ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  examRule        ExamRule        @relation(fields: [examRuleId], references: [id], onDelete: Restrict)
  answer          Answer?

  @@unique([attemptId, position])
  @@unique([attemptId, questionVersionId])
  /// Target of the composite foreign key from answers (P8).
  @@unique([attemptId, id, questionVersionId])
  @@index([questionVersionId])
  @@map("attempt_questions")
}

/// The student's response to one attempt question.
/// Composite keys ensure attempt, question and chosen option all match (P8).
model Answer {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId         String         @map("attempt_id") @db.Uuid
  attemptQuestionId String         @unique @map("attempt_question_id") @db.Uuid
  questionVersionId String         @map("question_version_id") @db.Uuid
  selectedOptionId  String?        @map("selected_option_id") @db.Uuid
  textAnswer        String?        @map("text_answer")
  /// NULL until the attempt is submitted (P3: no grading on save).
  gradingStatus     GradingStatus? @map("grading_status")
  marksAwarded      Decimal?       @map("marks_awarded") @db.Decimal(6, 2)
  gradedById        String?        @map("graded_by") @db.Uuid
  gradedAt          DateTime?      @map("graded_at") @db.Timestamptz(6)
  savedAt           DateTime       @default(now()) @map("saved_at") @db.Timestamptz(6)

  attempt         ExamAttempt     @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  attemptQuestion AttemptQuestion @relation(fields: [attemptId, attemptQuestionId, questionVersionId], references: [attemptId, id, questionVersionId], onDelete: Restrict)
  selectedOption  QuestionOption? @relation(fields: [questionVersionId, selectedOptionId], references: [questionVersionId, id], onDelete: Restrict)
  gradedBy        User?           @relation("AnswerGrader", fields: [gradedById], references: [id], onDelete: Restrict)

  essayMarks EssayMark[]

  /// Required by Prisma for the one-to-one composite relation above.
  @@unique([attemptId, attemptQuestionId, questionVersionId])
  @@index([attemptId])
  @@index([questionVersionId, gradingStatus])
  @@map("answers")
}

/// Tab/window focus losses. Server sets the times; < 1 second is logged, not counted.
model FocusEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId     String    @map("attempt_id") @db.Uuid
  /// Generated by the browser so retries are not stored twice (P7).
  clientEventId String    @map("client_event_id") @db.Uuid
  lostAt        DateTime  @map("lost_at") @db.Timestamptz(6)
  returnedAt    DateTime? @map("returned_at") @db.Timestamptz(6)
  durationMs    Int?      @map("duration_ms")
  isCounted     Boolean   @default(false) @map("is_counted")

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([attemptId, clientEventId])
  @@index([attemptId, lostAt])
  @@map("focus_events")
}

/// Invigilator time extensions. 1-15 minutes each, 15 in total per attempt, reason required.
model TimeExtension {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId   String   @map("attempt_id") @db.Uuid
  grantedById String   @map("granted_by") @db.Uuid
  minutes     Int
  reason      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  grantedBy User        @relation(fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([attemptId])
  @@map("time_extensions")
}

model InvigilatorNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  /// Optional: a note may be about one student or the whole session.
  studentId  String?  @map("student_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  text       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  schedule ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  student  User?        @relation("NoteStudent", fields: [studentId], references: [id], onDelete: Restrict)
  author   User         @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([scheduleId])
  @@map("invigilator_notes")
}

// =============================================================================
// F. Grading and results
// =============================================================================

/// One grader's mark for one essay answer (D7: FIRST and optional blind SECOND).
model EssayMark {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  answerId   String     @map("answer_id") @db.Uuid
  graderId   String     @map("grader_id") @db.Uuid
  graderRole GraderRole @map("grader_role")
  totalMarks Decimal    @map("total_marks") @db.Decimal(6, 2)
  comment    String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  answer         Answer               @relation(fields: [answerId], references: [id], onDelete: Restrict)
  grader         User                 @relation(fields: [graderId], references: [id], onDelete: Restrict)
  criterionMarks EssayCriterionMark[]

  @@unique([answerId, graderRole])
  /// The same person cannot be both graders of one answer.
  @@unique([answerId, graderId])
  @@map("essay_marks")
}

model EssayCriterionMark {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  essayMarkId       String  @map("essay_mark_id") @db.Uuid
  rubricCriterionId String  @map("rubric_criterion_id") @db.Uuid
  marks             Decimal @db.Decimal(6, 2)

  essayMark       EssayMark       @relation(fields: [essayMarkId], references: [id], onDelete: Restrict)
  rubricCriterion RubricCriterion @relation(fields: [rubricCriterionId], references: [id], onDelete: Restrict)

  @@unique([essayMarkId, rubricCriterionId])
  @@map("essay_criterion_marks")
}

/// D6: editable grading scale. Provisional defaults A 90 / B 80 / C 70 / D 60 / F 0.
model GradingScale {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  letter        String  @unique
  minPercentage Decimal @unique @map("min_percentage") @db.Decimal(5, 2)
  sortOrder     Int     @unique @map("sort_order")

  @@map("grading_scale")
}

/// Working copy of an attempt's result. Students never read this table directly;
/// they see the latest GradeRevision (P1).
model Grade {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId    String   @unique @map("attempt_id") @db.Uuid
  totalScore   Decimal  @map("total_score") @db.Decimal(8, 2)
  maxScore     Decimal  @map("max_score") @db.Decimal(8, 2)
  percentage   Decimal  @db.Decimal(5, 2)
  /// Copied from the grading scale at calculation time.
  letterGrade  String   @map("letter_grade")
  calculatedAt DateTime @default(now()) @map("calculated_at") @db.Timestamptz(6)

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@map("grades")
}

/// One publication of an exam's results. Append-only (P1).
model ResultPublication {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examId            String   @map("exam_id") @db.Uuid
  publicationNumber Int      @map("publication_number")
  publishedById     String   @map("published_by") @db.Uuid
  publishedAt       DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  /// Required from the second publication onward (CHECK).
  reason            String?

  exam        Exam            @relation(fields: [examId], references: [id], onDelete: Restrict)
  publishedBy User            @relation(fields: [publishedById], references: [id], onDelete: Restrict)
  revisions   GradeRevision[]

  @@unique([examId, publicationNumber])
  @@map("result_publications")
}

/// Permanent snapshot of one attempt's result at one publication. Append-only (P1).
model GradeRevision {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicationId      String   @map("publication_id") @db.Uuid
  attemptId          String   @map("attempt_id") @db.Uuid
  revisionNumber     Int      @map("revision_number")
  totalScore         Decimal  @map("total_score") @db.Decimal(8, 2)
  maxScore           Decimal  @map("max_score") @db.Decimal(8, 2)
  percentage         Decimal  @db.Decimal(5, 2)
  letterGrade        String   @map("letter_grade")
  /// Per-question marks at publication time.
  questionMarks      Json     @map("question_marks")
  countedFocusLosses Int      @map("counted_focus_losses")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  publication ResultPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  attempt     ExamAttempt       @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([attemptId, revisionNumber])
  @@unique([publicationId, attemptId])
  @@map("grade_revisions")
}

// =============================================================================
// G. Payments and messages (SIMULATED ONLY - no real gateways)
// =============================================================================

/// DEMO mobile-money payment (EVC Plus / Zaad / eDahab). is_simulated must be true.
model Payment {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId      String          @map("student_id") @db.Uuid
  examId         String          @map("exam_id") @db.Uuid
  provider       PaymentProvider
  phone          String
  /// Copied from the exam by the server - never taken from the browser.
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @db.Char(3)
  status         PaymentStatus   @default(PENDING_CONFIRMATION)
  merchantName   String          @map("merchant_name")
  merchantNumber String          @map("merchant_number")
  pinAttempts    Int             @default(0) @map("pin_attempts")
  failureReason  String?         @map("failure_reason")
  idempotencyKey String          @unique @map("idempotency_key") @db.Uuid
  mockReference  String?         @map("mock_reference")
  /// Set only on SUCCESS. Format DEMO-<EVC|ZAAD|EDAHAB>-YYYYMMDD-XXXXXX.
  receiptNumber  String?         @unique @map("receipt_number")
  /// Set by the database at creation: created_at + 5 minutes. Never changes.
  expiresAt      DateTime        @default(dbgenerated("(now() + '00:05:00'::interval)")) @map("expires_at") @db.Timestamptz(6)
  confirmedAt    DateTime?       @map("confirmed_at") @db.Timestamptz(6)
  isSimulated    Boolean         @default(true) @map("is_simulated")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(6)

  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  exam    Exam @relation(fields: [examId], references: [id], onDelete: Restrict)

  @@index([studentId, examId])
  /// Used to expire unfinished payments.
  @@index([status, expiresAt])
  @@map("payments")
}

/// Simulated SMS outbox. Messages are never sent to real phones.
model SmsOutbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId   String    @map("recipient_id") @db.Uuid
  phone         String
  language      Language
  templateKey   String    @map("template_key")
  params        Json
  /// Already translated into the recipient's language. Always starts with "[DEMO]".
  body          String
  senderId      String    @map("sender_id")
  segments      Int       @default(1)
  status        SmsStatus @default(QUEUED)
  relatedType   String?   @map("related_type")
  relatedId     String?   @map("related_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  failureReason String?   @map("failure_reason")
  isSimulated   Boolean   @default(true) @map("is_simulated")

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId])
  @@index([status, createdAt])
  @@map("sms_outbox")
}

/// In-app notifications (Q7). Translated when displayed, from template + params.
model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  templateKey String    @map("template_key")
  params      Json
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt])
  @@map("notifications")
}
