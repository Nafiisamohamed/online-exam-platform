{
  "name": "online-exam-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Online Exam Platform (Project 18) - Express API and database",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "node scripts/require-local-db.mjs migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:supabase-login": "node scripts/set-supabase-owner-url.mjs",
    "db:app-password": "node scripts/set-app-password.mjs",
    "db:seed:demo": "node scripts/seed-demo-data.mjs",
    "db:check": "node scripts/check-database.mjs",
    "verify:db": "vitest run --config vitest.verify.config.mjs",
    "test": "vitest run",
    "test:supabase": "node tests/run-supabase.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "pg": "8.19.0",
    "prisma": "7.10.1",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "dotenv": "16.4.7"
  }
}
